# Jacc LLM provider
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-5-mini

# Plain file logging is default. Set true only for terminal logs.
JACC_CONSOLE_LOGS=false

# Optional Langfuse tracing. Leave keys blank to disable.
# For local Docker Langfuse use http://localhost:3000.
# For Langfuse Cloud use your project host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
